{
  "manifest_version": 3,
  "name": "Claudsidian Capture",
  "version": "1.1.0",
  "description": "One-click capture to your Obsidian vault",
  "permissions": [
    "activeTab",
    "notifications",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "Claudsidian - Click to capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claudsidian@example.com"
    }
  }
}
