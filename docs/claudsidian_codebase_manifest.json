    },
    "tag_generation_prompts": {
      "status": "PARTIAL",
      "issue": "get_tag_generation_prompt() always returns ARTICLE_TAGS regardless of content_type. Content-specific tag prompts (VIDEO_TAGS, REPO_TAGS, etc.) exist but are unused",
      "impact": "All content types use article tagging rules instead of specialized prompts"
    },
